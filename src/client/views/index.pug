doctype html
html
  head
    meta(charset='UTF-8')
    meta(http-equiv='x-ua-compatible' content='IE=edge')
    meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
    title #{siteName}
    style.
      body {
        background: #0f141d;
      }
      #content-loading {
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 18px;
        background: #0f141d;
      }
      .anchor-splash-word {
        font-family: 'IBM Plex Mono', ui-monospace, monospace;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: 8px;
        color: #ffb454;
        text-indent: 8px;
      }
      .anchor-splash-sub {
        font-family: 'IBM Plex Mono', ui-monospace, monospace;
        font-size: 12px;
        letter-spacing: 6px;
        text-indent: 6px;
        color: #8b98ab;
      }
      .anchor-splash-controls {
        position: fixed;
        top: 0;
        right: 0;
        height: 40px;
        display: none;
        align-items: center;
      }
      .anchor-splash-controls button {
        width: 46px;
        height: 40px;
        border: none;
        background: transparent;
        color: #8b98ab;
        font-size: 14px;
        cursor: pointer;
      }
      .anchor-splash-controls button:hover {
        background: rgba(255,255,255,0.08);
        color: #e6edf5;
      }
      html[data-anchor-theme=light] .anchor-splash-controls button {
        color: #5d6b7e;
      }
      html[data-anchor-theme=light] .anchor-splash-controls button:hover {
        background: rgba(0,0,0,0.06);
        color: #1c2634;
      }
      html[data-anchor-theme=dark] .anchor-splash-controls button:hover {
        background: rgba(255,255,255,0.08);
        color: #e6edf5;
      }
      .anchor-splash-track {
        width: 132px;
        height: 2px;
        background: #2a3547;
        border-radius: 2px;
        position: relative;
        overflow: hidden;
      }
      .anchor-splash-track::after {
        content: '';
        position: absolute;
        left: -30%;
        top: 0;
        width: 30%;
        height: 100%;
        border-radius: 2px;
        background: #ffb454;
        animation: anchor-splash-sweep 1.4s ease-in-out infinite;
      }
      @keyframes anchor-splash-sweep {
        0% { left: -30%; }
        100% { left: 100%; }
      }
      html[data-anchor-theme=light] body,
      html[data-anchor-theme=light] #content-loading {
        background: #eef1f5;
      }
      html[data-anchor-theme=light] .anchor-splash-word {
        color: #b26a00;
      }
      html[data-anchor-theme=light] .anchor-splash-sub {
        color: #5d6b7e;
      }
      html[data-anchor-theme=light] .anchor-splash-track {
        background: #d4dbe4;
      }
      html[data-anchor-theme=light] .anchor-splash-track::after {
        background: #b26a00;
      }

    - if (!isDev)
      link(rel='stylesheet', href='css/style-' + version + '.css')
      style(id='theme-css').
      style(id='custom-css').
  body
    - if (isDev)
      style(id='theme-css').
      style(id='custom-css').
    script.
      // 启动屏即按上次主题渲染(与渲染层同一 key)
      (function () {
        var t = 'light'
        try { t = window.localStorage.getItem('anchor-theme') || 'light' } catch (e) {}
        document.documentElement.dataset.anchorTheme = t
        var isMac = /Macintosh|Mac|Mac OS|MacIntel/gi.test(navigator.userAgent)
        if (!isMac && window.pre && window.pre.runGlobalAsync) {
          window.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('anchor-splash-controls')
            if (!el) return
            el.style.display = 'flex'
            var min = el.querySelector('.sp-min')
            var max = el.querySelector('.sp-max')
            var close = el.querySelector('.sp-close')
            min.addEventListener('click', function () { window.pre.runGlobalAsync('minimize') })
            max.addEventListener('click', function () {
              window.pre.runGlobalAsync(max.dataset.max === '1' ? 'unmaximize' : 'maximize')
              max.dataset.max = max.dataset.max === '1' ? '0' : '1'
            })
            close.addEventListener('click', function () { window.pre.runGlobalAsync('closeApp') })
          })
        }
      })()
    #container
    #content-loading
      #anchor-splash-controls.anchor-splash-controls
        button.sp-min(title='最小化') –
        button.sp-max(title='最大化', data-max='0') ▢
        button.sp-close(title='关闭') ×
      .anchor-splash-word ANCHOR
      .anchor-splash-sub 锚点终端
      .anchor-splash-track
    script.
      window.et = !{JSON.stringify(_global)}
    - var url = '/src/client/entry/basic.js'
    - if (isDev)
      //- script(src='/external/react.development.js?' + version)
      //- script(src='/external/react-dom.development.js?' + version)
      script(type='module').
        import RefreshRuntime from '/@react-refresh'
        RefreshRuntime.injectIntoGlobalHook(window)
        window.$RefreshReg$ = () => {}
        window.$RefreshSig$ = () => (type) => type
        window.__vite_plugin_react_preamble_installed__ = true
      script(src='/@vite/client', type='module')
      script(src=url1, type='module')
      script(src=url, type='module')
    - else
      //- script(src='/external/react.production.min.js?' + version)
      //- script(src='/external/react-dom.production.min.js?' + version)
      - var url = src='/js/basic-' + version + '.js'
      script(src=url1, type='module')
      script(src=url, type='module')

