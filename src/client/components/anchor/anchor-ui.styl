// ANCHOR 组件样式:连接管理器 + 表单抽屉(P2)
// token 与 anchor.styl 一致

.anchor-mgr
  display flex
  flex-direction column
  height 62vh

.mg-tools
  display flex
  align-items center
  gap 8px
  padding 10px 4px
  border-bottom 1px solid var(--line, #2a3547)
  .tl
    height 26px
    padding 0 9px
    display flex
    align-items center
    gap 5px
    border 1px solid var(--line, #2a3547)
    border-radius 5px
    color var(--fog, #8b98ab)
    font-size 12px
    cursor pointer
    background none
    &:hover
      color var(--amber, #ffb454)
      border-color var(--amber, #ffb454)
  .mg-search
    flex 1
    border 1px solid var(--line, #2a3547)
    border-radius 14px
    padding 4px 12px
    outline none
    background var(--ink0, #0f141d)
    color var(--snow, #e6edf5)
    font-size 12px
    &:focus
      border-color var(--wave, #5aa9e6)

.mg-tree
  flex 1
  overflow-y auto
  background var(--ink0, #0f141d)
  margin 10px 0
  border 1px solid var(--line, #2a3547)
  border-radius 6px
  padding 8px
  outline none

.tnode
  display flex
  align-items center
  gap 7px
  padding 4px 8px
  border-radius 5px
  cursor default
  font-size 12.5px
  &:hover
    background var(--ink2, #1c2534)
  &.sel
    background var(--ink2, #1c2534)
    box-shadow inset 0 0 0 1px var(--wave, #5aa9e6)
  .arrow
    width 12px
    color var(--fog, #8b98ab)
    cursor pointer
    font-size 9px
    text-align center
    transition transform 0.15s
    flex-shrink 0
    &.open
      transform rotate(90deg)
    &.leaf
      visibility hidden
  .lbl
    color var(--snow, #e6edf5)
    &.dir
      color var(--amber, #ffb454)
  .cnt
    color #4d5b72
    font-size 11px
    font-family "IBM Plex Mono", monospace
  .usr
    color var(--fog, #8b98ab)
    font-size 11px
    margin-left auto
  mark
    background rgba(255, 180, 84, 0.32)
    color inherit
    border-radius 2px
    padding 0 1px
  input.rename
    flex 1
    border 1px solid var(--wave, #5aa9e6)
    border-radius 4px
    padding 1px 6px
    background var(--ink0, #0f141d)
    color var(--snow, #e6edf5)
    font 12.5px "IBM Plex Sans", sans-serif
    outline none

.empty-dir
  color #4d5b72
  font-size 11px
  padding 3px 8px 3px 34px
  font-style italic

.mg-foot
  display flex
  align-items center
  gap 16px
  padding 10px 4px 0
  border-top 1px solid var(--line, #2a3547)
  color var(--fog, #8b98ab)
  font-size 12px
  label
    display flex
    align-items center
    gap 6px
    cursor pointer
    margin-left auto
  .kbd
    font-family "IBM Plex Mono", monospace
    font-size 10px
    color #4d5b72

// 右键菜单
.anchor-ctx
  position fixed
  z-index 1000
  background var(--ink2, #1c2534)
  border 1px solid var(--line, #2a3547)
  border-radius 7px
  box-shadow 0 10px 30px rgba(0, 0, 0, 0.45)
  min-width 150px
  padding 5px
  div
    padding 6px 14px
    cursor pointer
    color var(--snow, #e6edf5)
    font-size 12.5px
    border-radius 4px
    display flex
    align-items center
    gap 8px
    &:hover
      background var(--ink1, #151c28)
      color var(--amber, #ffb454)
    .sub
      margin-left auto
      color var(--fog, #8b98ab)
      font-size 10px
    &.danger:hover
      color var(--alert, #f2555a)
    &.sep
      height 1px
      background var(--line, #2a3547)
      margin 4px 6px
      padding 0
      cursor default
    &.cap
      font-size 10px
      color var(--fog, #8b98ab)
      letter-spacing 1px
      padding 4px 14px 2px
      cursor default
      font-family "IBM Plex Mono", monospace

// 表单抽屉
.dr-sec
  border 1px solid var(--line, #2a3547)
  border-radius 7px
  margin-bottom 10px
  background var(--ink1, #151c28)
  overflow hidden
  > summary
    padding 8px 12px
    cursor pointer
    color var(--snow, #e6edf5)
    font-size 12.5px
    list-style none
    display flex
    align-items center
    gap 8px
    &::before
      content '▸'
      color var(--fog, #8b98ab)
      font-size 10px
  &[open]
    > summary
      &::before
        transform rotate(90deg)
      border-bottom 1px solid var(--line, #2a3547)
  .inner
    padding 6px 12px 12px

.fld
  display flex
  align-items center
  margin 8px 0
  gap 10px
  label
    width 58px
    color var(--fog, #8b98ab)
    flex-shrink 0
    text-align right
    font-size 12px
  input
    flex 1
    border 1px solid var(--line, #2a3547)
    border-radius 5px
    padding 6px 10px
    outline none
    background var(--ink0, #0f141d)
    color var(--snow, #e6edf5)
    font-size 12.5px
    &:focus
      border-color var(--wave, #5aa9e6)

.jump-hint
  color var(--fog, #8b98ab)
  font-size 11px
  padding 4px 0 8px

.jump-row
  display flex
  align-items center
  gap 6px
  margin 6px 0
  .seq
    font-family "IBM Plex Mono", monospace
    color var(--amber, #ffb454)
    font-size 11px
    width 14px
    text-align center
  .jump-btn
    border 1px solid var(--line, #2a3547)
    background none
    border-radius 4px
    width 24px
    height 24px
    color var(--fog, #8b98ab)
    font-size 11px
    cursor pointer
    &:hover
      color var(--amber, #ffb454)
      border-color var(--amber, #ffb454)

.add-jump
  color var(--amber, #ffb454)
  font-size 12px
  padding 5px 0 0
  cursor pointer
  background none
  border none
  &:hover
    text-decoration underline

.anchor-btn
  padding 6px 18px
  border-radius 5px
  border 1px solid var(--line, #2a3547)
  color var(--snow, #e6edf5)
  font-size 12px
  cursor pointer
  background none
  &:hover
    border-color var(--fog, #8b98ab)
  &.pri
    background var(--amber, #ffb454)
    border-color var(--amber, #ffb454)
    color #1a1206
    font-weight 600
    &:hover
      background #ffc472
