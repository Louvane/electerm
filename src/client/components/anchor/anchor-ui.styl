  margin-top 4px

.anchor-hint
  font-size 10px
  color var(--fog, #9aa0b5)
  opacity 0.7
  margin-top 4px

.anchor-cmdbox .cnt
  color #4d5b72
  font-size 10px

.cp-item.sel
  background var(--ink1, #151c28)
  box-shadow inset 0 0 0 1px var(--amber, #5c8dff)
.cp-item .cp-freq
  color #4d5b72
  font-size 10px
  margin-left 8px
  font-family "IBM Plex Mono", monospace

// 设置入口(遥测栏底部)
.anchor-rail-settings
  width 100%
  margin-top 12px
  padding 7px 0
  border 1px solid var(--line, #2a3547)
  border-radius 6px
  background none
  color var(--fog, #8b98ab)
  font-size 12px
  cursor pointer
  &:hover
    color var(--amber, #ffb454)
    border-color var(--amber, #ffb454)

// 设置抽屉:标签略宽,防“退出前确认”换行
.settings-drawer .fld label
  width 64px

// 兼容空态旧类 .btn → 同 .anchor-btn
.btn
  padding 6px 18px
  border-radius 5px
  border 1px solid var(--line, #2a3547)
  color var(--snow, #e6edf5)
  font-size 12px
  cursor pointer
  background none
  &:hover
    border-color var(--fog, #8b98ab)
  &.pri
    background var(--amber, #ffb454)
    border-color var(--amber, #ffb454)
    color #1a1206
    font-weight 600
    &:hover
      background #ffc472

// 抽屉头部关闭可点（排除标题栏 drag）
.ant-drawer-header,
.ant-drawer-close
  -webkit-app-region no-drag
  pointer-events auto

// 设置抽屉关闭图标可点：排除拖拽区干扰
.settings-drawer .ant-drawer-header,
.settings-drawer .ant-drawer-close
  -webkit-app-region no-drag
  pointer-events auto

// 终端区跟随主题：白天纸白，夜晚墨黑
.term-wrap,
.xterm,
.xterm-viewport,
.xterm-screen
  background var(--termBg, #0f141d) !important

// 管理器树亮模式淡灰，与弹窗纸白拉层级
