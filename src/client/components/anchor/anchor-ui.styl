// ANCHOR 组件样式:连接管理器 + 表单抽屉(P2)
// token 与 anchor.styl 一致

.anchor-mgr
  display flex
  flex-direction column
  height 62vh

.mg-tools
  display flex
  align-items center
  gap 8px
  padding 10px 4px
  border-bottom 1px solid var(--line, #2a3547)
  .tl
    height 26px
    padding 0 9px
    display flex
    align-items center
    gap 5px
    border 1px solid var(--line, #2a3547)
    border-radius 5px
    color var(--fog, #8b98ab)
    font-size 12px
    cursor pointer
    background none
    &:hover
      color var(--amber, #ffb454)
      border-color var(--amber, #ffb454)
  .mg-search
    flex 1
    border 1px solid var(--line, #2a3547)
    border-radius 14px
    padding 4px 12px
    outline none
    background var(--ink0, #0f141d)
    color var(--snow, #e6edf5)
    font-size 12px
    &:focus
      border-color var(--wave, #5aa9e6)

.mg-tree
  flex 1
  overflow-y auto
  background var(--ink0, #1a1c2e)
  margin 10px 0
  border 1px solid var(--line, #34374f)
  border-radius 10px
  padding 8px
  outline none

.tnode
  display flex
  align-items center
  gap 7px
  padding 5px 8px
  border-radius 7px
  cursor default
  font-size 12.5px
  transition background 0.12s
  &:hover
    background var(--ink2, #1c2534)
  &.sel
    background var(--ink2, #1c2534)
    box-shadow inset 0 0 0 1px var(--wave, #5aa9e6)
  .arrow
    width 12px
    color var(--fog, #8b98ab)
    cursor pointer
    font-size 9px
    text-align center
    transition transform 0.15s
    flex-shrink 0
    &.open
      transform rotate(90deg)
    &.leaf
      visibility hidden
  .lbl
    color var(--snow, #e6edf5)
    &.dir
      color var(--amber, #ffb454)
  .cnt
    color #4d5b72
    font-size 11px
    font-family "IBM Plex Mono", monospace
  .usr
    color var(--fog, #8b98ab)
    font-size 11px
    margin-left auto
  mark
    background rgba(255, 180, 84, 0.32)
    color inherit
    border-radius 2px
    padding 0 1px
  input.rename
    flex 1
    border 1px solid var(--wave, #5aa9e6)
    border-radius 4px
    padding 1px 6px
    background var(--ink0, #0f141d)
    color var(--snow, #e6edf5)
    font 12.5px "IBM Plex Sans", sans-serif
    outline none

.empty-dir
  color #4d5b72
  font-size 11px
  padding 3px 8px 3px 34px
  font-style italic

.mg-foot
  display flex
  align-items center
  gap 16px
  padding 10px 4px 0
  border-top 1px solid var(--line, #2a3547)
  color var(--fog, #8b98ab)
  font-size 12px
  label
    display flex
    align-items center
    gap 6px
    cursor pointer
    margin-left auto
  .kbd
    font-family "IBM Plex Mono", monospace
    font-size 10px
    color #4d5b72

// 右键菜单
.anchor-ctx
  position fixed
  z-index 1000
  background var(--ink2, #2a2d45)
  border 1px solid var(--line, #34374f)
  border-radius 10px
  box-shadow var(--shadow, 0 8px 28px rgba(10, 12, 24, 0.45))
  min-width 150px
  padding 5px
  div
    padding 6px 14px
    cursor pointer
    color var(--snow, #e6edf5)
    font-size 12.5px
    border-radius 4px
    display flex
    align-items center
    gap 8px
    &:hover
      background var(--ink1, #151c28)
      color var(--amber, #ffb454)
    .sub
      margin-left auto
      color var(--fog, #8b98ab)
      font-size 10px
    &.danger:hover
      color var(--alert, #f2555a)
    &.sep
      height 1px
      background var(--line, #2a3547)
      margin 4px 6px
      padding 0
      cursor default
    &.cap
      font-size 10px
      color var(--fog, #8b98ab)
      letter-spacing 1px
      padding 4px 14px 2px
      cursor default
      font-family "IBM Plex Mono", monospace

// 表单抽屉
.dr-sec
  border 1px solid var(--line, #2a3547)
  border-radius 7px
  margin-bottom 10px
  background var(--ink1, #151c28)
  overflow hidden
  > summary
    padding 8px 12px
    cursor pointer
    color var(--snow, #e6edf5)
    font-size 12.5px
    list-style none
    display flex
    align-items center
    gap 8px
    &::before
      content '▸'
      color var(--fog, #8b98ab)
      font-size 10px
  &[open]
    > summary
      &::before
        transform rotate(90deg)
      border-bottom 1px solid var(--line, #2a3547)
  .inner
    padding 6px 12px 12px

.fld
  display flex
  align-items center
  margin 8px 0
  gap 10px
  label
    width 58px
    color var(--fog, #8b98ab)
    flex-shrink 0
    text-align right
    font-size 12px
  input
    flex 1
    border 1px solid var(--line, #2a3547)
    border-radius 5px
    padding 6px 10px
    outline none
    background var(--ink0, #0f141d)
    color var(--snow, #e6edf5)
    font-size 12.5px
    &:focus
      border-color var(--wave, #5aa9e6)

.jump-hint
  color var(--fog, #8b98ab)
  font-size 11px
  padding 4px 0 8px

.jump-row
  display flex
  align-items center
  gap 6px
  margin 6px 0
  .seq
    font-family "IBM Plex Mono", monospace
    color var(--amber, #ffb454)
    font-size 11px
    width 14px
    text-align center
  .jump-btn
    border 1px solid var(--line, #2a3547)
    background none
    border-radius 4px
    width 24px
    height 24px
    color var(--fog, #8b98ab)
    font-size 11px
    cursor pointer
    &:hover
      color var(--amber, #ffb454)
      border-color var(--amber, #ffb454)

.add-jump
  color var(--amber, #ffb454)
  font-size 12px
  padding 5px 0 0
  cursor pointer
  background none
  border none
  &:hover
    text-decoration underline

.anchor-btn
  padding 7px 18px
  border-radius 8px
  border 1px solid var(--line, #34374f)
  color var(--snow, #e8ebf4)
  font-size 12.5px
  cursor pointer
  background none
  transition all 0.15s
  &:hover
    border-color var(--fog, #9aa0b5)
  &.pri
    background var(--amber, #5c8dff)
    border-color var(--amber, #5c8dff)
    color #fff
    font-weight 600
    &:hover
      filter brightness(1.08)

// 快速连接页
.page-home
  height 100%
  overflow-y auto
  padding 40px clamp(24px, 6vw, 90px)
.home-head
  display flex
  align-items baseline
  gap 14px
  margin-bottom 6px
  h1
    font-size 19px
    font-weight 600
    letter-spacing 1px
  .sub
    color var(--fog, #8b98ab)
    font-size 12px
.qc-panel
  margin-top 18px
  border 1px solid var(--line, #34374f)
  border-radius 12px
  background var(--ink1, #22243a)
  overflow hidden
  box-shadow var(--shadow, 0 8px 28px rgba(10, 12, 24, 0.45))
.qc-toolbar
  display flex
  align-items center
  padding 9px 14px
  border-bottom 1px solid var(--line, #2a3547)
  gap 10px
  .cap
    font-family "IBM Plex Mono", monospace
    font-size 11px
    letter-spacing 2px
    color var(--fog, #8b98ab)
  .n
    font-family "IBM Plex Mono", monospace
    color var(--amber, #ffb454)
  .sp
    flex 1
  button.hint
    color var(--fog, #8b98ab)
    font-size 12px
    padding 2px 8px
    border-radius 4px
    cursor pointer
    background none
    border none
    &:hover
      color var(--snow, #e6edf5)
      background var(--ink2, #1c2534)
.qc-row
  display flex
  align-items center
  padding 10px 14px
  gap 14px
  cursor pointer
  border-bottom 1px solid rgba(52, 55, 79, 0.45)
  transition background 0.12s
  &:last-child
    border-bottom none
  &:hover
    background var(--ink2, #1c2534)
  .st
    width 7px
    height 7px
    border-radius 50%
    background var(--dot, #3a465a)
    flex-shrink 0
  &.open .st
    background var(--signal, #3fd68f)
    box-shadow 0 0 5px var(--signal, #3fd68f)
  .nm
    width 130px
    color var(--snow, #e6edf5)
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
  .ip
    width 140px
    color var(--fog, #8b98ab)
    font-size 12px
  .usr
    width 80px
    color var(--fog, #8b98ab)
    font-size 12px
    text-align right
    margin-left auto
.qc-empty
  text-align center
  padding 70px 0 60px
  .big
    font-size 15px
    color var(--snow, #e6edf5)
    margin-bottom 6px
  .sm
    color var(--fog, #8b98ab)
    font-size 12px
    margin-bottom 18px
  .acts
    display flex
    gap 10px
    justify-content center
.home-tip
  margin-top 14px
  color #4d5b72
  font-size 11px
  font-family "IBM Plex Mono", monospace

// 遥测栏实时数据样式
.anchor-rail
  .anchor-tabs
    display flex
    gap 4px
    margin-bottom 6px
  .anchor-tabbtn
    flex 1
    padding 3px 0
    border 1px solid var(--line, #2a3547)
    border-radius 4px
    font-size 11px
    color var(--fog, #8b98ab)
    background none
    cursor pointer
    &.on
      color var(--amber, #ffb454)
      border-color var(--amber, #ffb454)
  .anchor-chart
    border 1px solid var(--line, #2a3547)
    border-radius 4px
    background var(--ink0, #0f141d)
    overflow hidden
  .anchor-cmdbox
    border 1px solid var(--line, #2a3547)
    border-radius 4px
    background var(--ink0, #0f141d)
    height 96px
    overflow-y auto
    padding 5px 8px
    div
      font-family "IBM Plex Mono", monospace
      font-size 11px
      color var(--fog, #8b98ab)
      white-space nowrap
      overflow hidden
      text-overflow ellipsis
      padding 1.5px 0
      b
        color var(--amber, #ffb454)
        font-weight 400
  .gauge
    .top
      display flex
      justify-content space-between
      align-items baseline
      margin-bottom 3px
      .k
        color var(--fog, #8b98ab)
        font-size 11px
        letter-spacing 1px
      .v
        font-family "IBM Plex Mono", monospace
        font-size 13px
        color var(--amber, #ffb454)
    .rail
      height 4px
      background var(--rail, #232d3e)
      border-radius 2px
      overflow hidden
      > div
        height 100%
        border-radius 2px
        transition width 0.7s
    .sub
      font-family "IBM Plex Mono", monospace
      font-size 10px
      color var(--fog, #8b98ab)
      margin-top 2px
  .net-row
    display flex
    align-items center
    gap 7px
    margin 5px 0
    .net-dir
      font-family "IBM Plex Mono", monospace
      font-size 11px
      width 12px
      &.up
        color var(--alert, #f2555a)
      &.down
        color var(--signal, #3fd68f)
    .net-rail
      flex 1
      height 3px
      background var(--rail, #232d3e)
      border-radius 2px
      overflow hidden
      > div
        height 100%
        transition width 0.7s
    .net-val
      font-family "IBM Plex Mono", monospace
      font-size 11px
      color var(--fog, #8b98ab)
      width 62px
      text-align right
  .live-dot
    width 6px
    height 6px
    border-radius 50%
    background var(--signal, #3fd68f)
    box-shadow 0 0 6px var(--signal, #3fd68f)
    display inline-block
    align-self center
.anchor-kv
  display flex
  justify-content space-between
  margin 3px 0
  span
    color var(--fog, #8b98ab)
    font-size 11px
  b
    font-weight 400
    font-family "IBM Plex Mono", monospace
    font-size 12px
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    max-width 120px
    &.ip
      color var(--amber, #ffb454)

// 主题:黑夜模式下 antd 浮层适配(白天 antd 默认浅色即可)
body[data-anchor-theme=dark]
  .ant-select-dropdown
    background var(--ink2, #1c2534)
    .ant-select-item
      color var(--snow, #e6edf5)
      &:hover
        background var(--ink1, #151c28)
    .ant-select-item-option-selected
      background var(--ink1, #151c28)
      color var(--amber, #ffb454)
  .ant-modal-content
    background var(--ink2, #1c2534)
    color var(--snow, #e6edf5)
  .ant-modal-header
    background var(--ink2, #1c2534)
    .ant-modal-title
      color var(--snow, #e6edf5)
  .ant-drawer-content
    background var(--ink2, #1c2534)
    .ant-drawer-header
      background var(--ink2, #1c2534)
      border-bottom-color var(--line, #2a3547)
      .ant-drawer-title
        color var(--snow, #e6edf5)
  .ant-message-notice-content
    background var(--ink2, #1c2534)
    color var(--snow, #e6edf5)
  .ant-btn-default
    background var(--ink1, #151c28)
    color var(--snow, #e6edf5)
    border-color var(--line, #2a3547)
  .ant-modal-confirm
    .ant-modal-body
      color var(--snow, #e6edf5)

// 主题切换按钮
.anchor-theme-btn
  height 26px
  padding 0 12px
  border 1px solid var(--line, #2a3547)
  border-radius 13px
  color var(--fog, #8b98ab)
  font-size 12px
  cursor pointer
  background none
  &:hover
    color var(--amber, #ffb454)
    border-color var(--amber, #ffb454)

// ===== 动画层(P6.5)=====
// 视图/页面切入
.anchor-content > *
  animation anchor-fade-in 0.18s ease
@keyframes anchor-fade-in
  from
    opacity 0
    transform translateY(4px)
  to
    opacity 1
    transform none

// 右键菜单弹入
.anchor-ctx
  animation ctx-pop 0.12s ease
@keyframes ctx-pop
  from
    opacity 0
    transform scale(0.96)
  to
    opacity 1
    transform none

// 列表行渐入(快速连接/管理器树首层)
.qc-row
  animation row-in 0.2s ease both
@keyframes row-in
  from
    opacity 0
    transform translateX(-6px)
  to
    opacity 1
    transform none

// 尊重减弱动效偏好
@media (prefers-reduced-motion: reduce)
  .anchor-content > *
  .anchor-ctx
  .qc-row
    animation none !important

// 弹框 header:去掉 antd 默认底色横带,✕ 对齐
body[data-anchor-theme=dark]
  .ant-modal-header
    background transparent !important
    border-bottom none !important
  .ant-modal-title
    color var(--snow, #e8ebf4) !important
  .ant-modal-content
    background var(--ink2, #2a2d45) !important
  .ant-modal-close
    top 14px !important
    right 14px !important
    color var(--fog, #9aa0b5) !important
    &:hover
      color var(--snow, #e8ebf4) !important
      background var(--ink1, #22243a) !important
