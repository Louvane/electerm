@keyframes rotate
  from
    background-position -3000px
  to
    background-position 0px
// ANCHOR 琥珀风面板 tab(布局不变,仅视觉)
.type-tab-line
  position absolute
  bottom 0
  left 0
  width 100%
  height 2px
  border-radius 2px
  background var(--amber, #5c8dff)
  opacity 0.25
  display none
.type-tab-txt
  position relative
  display inline-block

.type-tab
  display inline-block
  vertical-align middle
  line-height 30px
  padding 0 16px 0 0
  margin-right 0px
  font-size 13px
  letter-spacing 0.5px
  color #8b98ab
  cursor pointer
  transition color 0.15s
  &:hover
    color #e8ecf4
    .type-tab-line
      display inline-block
  &.active
    color var(--amber, #5c8dff)
    .type-tab-line
      display inline-block
      opacity 1

.is-transporting
  .type-tab.sftp
    .type-tab-line
      display inline-block
      background linear-gradient(to right, var(--amber, #5c8dff) 0%, transparent 30%, transparent 70%, var(--amber, #5c8dff) 100%)
      animation: rotate 60s infinite linear
.disable-ssh
  .type-tab.ssh
    display none
.spliter
  color #8b98ab
  transition color 0.15s
  &:hover
    color #e8ecf4

.sessions
  position absolute
  background var(--main)
.session-wrap
  display none
  position absolute
  overflow hidden
  z-index 3
  padding-top 0
  box-shadow 0px 0px 1px 1px var(--main-darker)
  &.session-batch-active
    display block

.term-sftp-box
  height 100%
.web-session-wrap
  height 100%
  background var(--main)
  overflow hidden
  display flex
  flex-direction column
.web-session-content
  flex 1
  min-height 0
  overflow hidden
.session-v-info
  line-height 30px
.vnc-scroll-wrapper
  position relative
  background var(--main)
  z-index 299
  &::-webkit-scrollbar
    width 16px
    height 16px
    background var(--main-darker)
  &::-webkit-scrollbar-track
    background var(--main-darker)
    box-shadow inset 0 0 5px var(--main-darker)
  &::-webkit-scrollbar-thumb
    background var(--primary)
    border-radius 0
  &::-webkit-scrollbar-corner
    background var(--main-darker)

.not-split-view > .ant-splitter-bar .ant-splitter-bar-dragger
  display none

// 会话图标:统一雾灰/琥珀两态,active 加指示点
.sess-icon
  margin-right 12px
  position relative
  transition color 0.15s
  &:hover
    color #e8ecf4
  &.active
    color var(--amber, #5c8dff)
  &.active::after
    content ''
    position absolute
    left 50%
    transform translateX(-50%)
    bottom -4px
    width 3px
    height 3px
    border-radius 50%
    background var(--amber, #5c8dff)

.wrap-toggle-icon
.split-view-toggle
  &.active
    color var(--amber, #5c8dff)
// FinalShell 式底部实时监控条
.monitor-strip
  height 110px
  border-top 1px solid var(--border)
  background var(--main-darker)
  display flex
  flex-direction column
  font-size 12px
  overflow hidden
  &.collapsed
    height 26px
    flex-direction row
    align-items center
    gap 10px
    padding 0 8px
    cursor pointer
  .monitor-header
    display flex
    justify-content space-between
    align-items center
    padding 2px 8px
    color var(--text)
  .monitor-title
    color var(--text-light)
  .monitor-close
    color var(--text)
    &:hover
      color var(--text-light)
  .monitor-body
    flex 1
    display flex
    min-height 0
  .monitor-item
    flex 1
    padding 0 8px 4px
    min-width 0
    display flex
    flex-direction column
  .monitor-label
    color var(--text)
    line-height 16px
  .monitor-val
    margin-left 6px
    color var(--text-light)

// 白天会话容器浅（原 --main 炭）
body[data-anchor-theme=light] .sessions,
body[data-anchor-theme=light] .web-session-wrap
  background var(--ink0, #eef1f5) !important
