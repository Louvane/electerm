// ANCHOR 布局壳样式(P0)——token 与 demo 对齐
.anchor-shell
  position absolute
  top 0
  right 0
  bottom 0
  left 0
  display flex
  flex-direction column
  background var(--ink0, #0f141d)
  color var(--snow, #e6edf5)
  font-size 13px

.anchor-rail
  width 212px
  flex-shrink 0
  background var(--ink1, #151c28)
  border-right 1px solid var(--line, #2a3547)
  display flex
  flex-direction column
  padding 12px
  gap 12px
.anchor-logo
  font-family "IBM Plex Mono", monospace
  font-weight 700
  letter-spacing 2px
  color var(--amber, #ffb454)
  font-size 13px
  i
    font-style normal
    color var(--fog, #8b98ab)
    font-weight 400
    letter-spacing 0
    margin-left 8px
    font-size 11px
.anchor-rail-sec
  border-top 1px solid var(--line, #2a3547)
  padding-top 10px
.anchor-cap
  font-family "IBM Plex Mono", monospace
  font-size 10px
  letter-spacing 2px
  color var(--fog, #8b98ab)
  margin-bottom 6px
.anchor-kv
  display flex
  justify-content space-between
  margin 3px 0
  span
    color var(--fog, #8b98ab)
    font-size 11px
  b
    font-weight 400
    font-family "IBM Plex Mono", monospace
    font-size 12px
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    max-width 120px
.anchor-rail-foot
  margin-top auto
  color #4d5b72
  font-size 10px
  font-family "IBM Plex Mono", monospace

.anchor-main
  flex 1
  display flex
  flex-direction column
  min-width 0
.anchor-tabbar
  height 40px
  background var(--ink1, #151c28)
  border-bottom 1px solid var(--line, #2a3547)
  display flex
  align-items center
  padding 0 10px
  gap 6px
.anchor-mgr-btn
  height 30px
  padding 0 12px
  border 1px solid var(--line, #34374f)
  border-radius 8px
  color var(--fog, #9aa0b5)
  font-size 12.5px
  cursor pointer
  background none
  transition all 0.15s
  &:hover
    color var(--amber, #5c8dff)
    border-color var(--amber, #5c8dff)
    background rgba(92, 141, 255, 0.08)
.anchor-tabs
  display flex
  gap 4px
  margin-left 4px
.anchor-tab
  height 30px
  padding 0 12px
  display flex
  align-items center
  gap 7px
  border-radius 8px
  cursor pointer
  color var(--fog, #9aa0b5)
  font-size 12.5px
  transition background 0.15s
  .dot
    width 6px
    height 6px
    border-radius 50%
    background var(--dot, #454968)
  &.on
    background var(--ink2, #2a2d45)
    color var(--snow, #e8ebf4)
    box-shadow 0 1px 4px rgba(10, 12, 24, 0.25)
    .dot
      background var(--signal, #3fd68f)
.anchor-newtab
  width 28px
  height 28px
  border 1px dashed var(--line, #34374f)
  border-radius 8px
  color var(--fog, #9aa0b5)
  background none
  cursor pointer
  &:hover
    color var(--amber, #5c8dff)
    border-color var(--amber, #5c8dff)
.anchor-spacer
  flex 1
.anchor-content
  flex 1
  min-height 0
  position relative
.anchor-bridge-proof
  padding 40px 60px
  h2
    font-size 18px
    letter-spacing 1px
    margin-bottom 10px
  p
    color var(--fog, #8b98ab)
    margin 4px 0
.anchor-tab
  .x
    width 16px
    height 16px
    line-height 15px
    text-align center
    border-radius 3px
    color var(--fog, #8b98ab)
    visibility hidden
    cursor pointer
    flex-shrink 0
  &:hover .x
    visibility visible
  .x:hover
    background var(--alert, #f2555a)
    color #fff

// 全局字体(Termius 风:Inter 系)
.anchor-shell
  font-family "Inter", -apple-system, "PingFang SC", "Segoe UI", sans-serif

// 无边框窗口标题栏:mac 红绿灯避让 + 拖拽区
.anchor-titlebar
  height 40px
  flex-shrink 0
  -webkit-app-region drag
  display flex
  align-items center
  padding-left 12px
  background var(--ink1, #22243a)
  &.mac
    padding-left 84px
  .anchor-titlebar-text
    font-family "Inter", sans-serif
    font-weight 700
    letter-spacing 1.5px
    color var(--amber, #5c8dff)
    font-size 12.5px
    -webkit-app-region no-drag
    pointer-events none
.anchor-body
  flex 1
  display flex
  flex-direction row
  min-height 0

// 多标签排列:不收缩,横向滚动,标题省略
// 跟随标签流(+ 永远紧贴最后一个标签,不悬空居中)
.anchor-tabs
  flex 0 1 auto
  min-width 0
  overflow-x auto
  overflow-y hidden
  scrollbar-width none
  &::-webkit-scrollbar
    display none
.anchor-tab
  flex-shrink 0
  max-width 190px
  span:not(.x):not(.dot)
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

// 工具按钮不收缩不换行
.anchor-tabbar
  overflow hidden
.anchor-mgr-btn
  flex-shrink 0
  white-space nowrap
.anchor-newtab
  flex-shrink 0
.anchor-theme-btn
  flex-shrink 0
  white-space nowrap

// ===== P8 图标导航栏 =====
.icon-rail
  width 48px
  flex-shrink 0
  background var(--ink1, #22243a)
  border-right 1px solid var(--line, #34374f)
  display flex
  flex-direction column
  align-items center
  padding 10px 0
  gap 6px
.icon-rail-btn
  width 36px
  height 36px
  display flex
  align-items center
  justify-content center
  border-radius 9px
  color var(--fog, #9aa0b5)
  background none
  cursor pointer
  position relative
  transition background 0.15s, color 0.15s
  &:hover
    color var(--snow, #e8ebf4)
    background var(--ink2, #2a2d45)
  &.on
    color var(--amber, #5c8dff)
    background rgba(92, 141, 255, 0.14)
.icon-rail-spacer
  flex 1

// ===== 主机侧栏(原弹窗内容常驻)=====
.host-sidebar
  width 250px
  flex-shrink 0
  background var(--ink1, #151c28)
  border-right 1px solid var(--line, #34374f)
  display flex
  flex-direction column
  overflow hidden
.hs-search
  display flex
  align-items center
  gap 8px
  padding 10px 12px
  color var(--fog, #8b98ab)
  input
    flex 1
    border none
    outline none
    background transparent
    color var(--snow, #e8ebf4)
    font-size 12.5px
.hs-tree
  flex 1
  overflow-y auto
  padding 6px
  outline none
.hs-foot
  display flex
  gap 6px
  padding 10px 12px
  border-top 1px solid var(--line, #34374f)
  button
    flex 1
    height 28px
    display flex
    align-items center
    justify-content center
    gap 5px
    border 1px solid var(--line, #34374f)
    border-radius 7px
    background none
    color var(--fog, #9aa0b5)
    font-size 11.5px
    cursor pointer
    &:hover
      color var(--amber, #ffb454)
      border-color var(--amber, #ffb454)

// 遥测侧栏视图:复用 anchor-rail 语义,宽一点
.telemetry-side
  width 280px

// ===== 底部状态条 =====
.anchor-statusbar
  height 26px
  flex-shrink 0
  background var(--ink1, #151c28)
  border-top 1px solid var(--line, #34374f)
  display flex
  align-items center
  gap 16px
  padding 0 14px
  font-size 11px
  color var(--fog, #9aa0b5)
  &.idle
    justify-content space-between
  .sb-dot
    width 7px
    height 7px
    border-radius 50%
    background var(--dot, #454968)
    &.on
      background var(--signal, #3fd68f)
      box-shadow 0 0 5px var(--signal, #3fd68f)
  .sb-host
    color var(--snow, #e8ebf4)
    font-family "IBM Plex Mono", monospace
    font-size 11px
  .sb-item b
    font-weight 500
    color var(--snow, #e8ebf4)
    font-family "IBM Plex Mono", monospace
  .sb-item.net b
    color inherit
  .dim
    opacity 0.6
  .sb-right
    margin-left auto
    font-family "IBM Plex Mono", monospace
    font-size 10px
