// ANCHOR 布局壳样式(P0)——token 与 demo 对齐
.anchor-shell
  position absolute
  top 0
  right 0
  bottom 0
  left 0
  display flex
  flex-direction column
.anchor-titlebar
  height 40px
  flex-shrink 0
  -webkit-app-region drag
  display flex
  align-items center
  padding-left 84px
  background var(--ink1, #151c28)
  .anchor-titlebar-text
    font-family "IBM Plex Mono", monospace
    font-weight 700
    letter-spacing 2px
    color var(--amber, #ffb454)
    font-size 13px
    i
      font-style normal
      color var(--fog, #8b98ab)
      font-weight 400
      letter-spacing 0
      margin-left 8px
      font-size 11px
  background var(--ink0, #0f141d)
  color var(--snow, #e6edf5)
  font-size 13px

.anchor-rail
  width 212px
  flex-shrink 0
  background var(--ink1, #151c28)
  border-right 1px solid var(--line, #2a3547)
  display flex
  flex-direction column
  padding 12px
  gap 12px
.anchor-logo
  font-family "IBM Plex Mono", monospace
  font-weight 700
  letter-spacing 2px
  color var(--amber, #ffb454)
  font-size 13px
  i
    font-style normal
    color var(--fog, #8b98ab)
    font-weight 400
    letter-spacing 0
    margin-left 8px
    font-size 11px
.anchor-rail-sec
  border-top 1px solid var(--line, #2a3547)
  padding-top 10px
.anchor-cap
  font-family "IBM Plex Mono", monospace
  font-size 10px
  letter-spacing 2px
  color var(--fog, #8b98ab)
  margin-bottom 6px
.anchor-kv
  display flex
  justify-content space-between
  margin 3px 0
  span
    color var(--fog, #8b98ab)
    font-size 11px
  b
    font-weight 400
    font-family "IBM Plex Mono", monospace
    font-size 12px
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    max-width 120px
.anchor-rail-foot
  margin-top auto
  color #4d5b72
  font-size 10px
  font-family "IBM Plex Mono", monospace

.anchor-main
  flex 1
  display flex
  flex-direction column
  min-width 0
.anchor-tabbar
  height 40px
  background var(--ink1, #151c28)
  border-bottom 1px solid var(--line, #2a3547)
  display flex
  align-items center
  padding 0 10px
  gap 6px
.anchor-mgr-btn
  height 28px
  padding 0 10px
  border 1px solid var(--line, #2a3547)
  border-radius 5px
  color var(--fog, #8b98ab)
  font-size 12px
  cursor pointer
  background none
.anchor-tabs
  display flex
  gap 4px
  margin-left 4px
.anchor-tab
  height 29px
  padding 0 12px
  display flex
  align-items center
  gap 7px
  border-radius 6px
  cursor pointer
  color var(--fog, #8b98ab)
  font-size 12px
  .dot
    width 6px
    height 6px
    border-radius 50%
    background #3a465a
  &.on
    background var(--ink2, #1c2534)
    color var(--snow, #e6edf5)
    box-shadow inset 0 0 0 1px var(--line, #2a3547)
    .dot
      background var(--signal, #3fd68f)
.anchor-newtab
  width 26px
  height 26px
  border 1px dashed var(--line, #2a3547)
  border-radius 5px
  color var(--fog, #8b98ab)
  background none
  cursor pointer
.anchor-spacer
  flex 1
.anchor-content
  flex 1
  min-height 0
  position relative
  background var(--ink0, #0f141d)
.anchor-bridge-proof
  padding 40px 60px
  h2
    font-size 18px
    letter-spacing 1px
    margin-bottom 10px
  p
    color var(--fog, #8b98ab)
    margin 4px 0

.anchor-body
  flex 1
  display flex
  min-height 0

// 多标签:横向滚动 + 不收缩
.anchor-tabs
  flex 0 1 auto
  min-width 0
  overflow-x auto
  overflow-y hidden
  scrollbar-width none
  &::-webkit-scrollbar
    display none
.anchor-tab
  flex-shrink 0
  span
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
.anchor-mgr-btn
.anchor-newtab
.anchor-theme-btn
  flex-shrink 0
  white-space nowrap
.anchor-tabbar
  overflow hidden

// 全屏退出浮钮(native 红绿灯之上层级;termSearchBox z 30)
// 注意:窗口是 transparent:true,macOS 对低 alpha 像素做穿透命中,
// 此按钮禁止任何元素级 opacity/低透明底,否则真机点击穿透(e2e 测不出)
.anchor-fs-exit
  position fixed
  top 8px
  right 8px
  z-index 99999
  user-select none
  height 26px
  padding 0 12px
  font-size 12px
  color #cfd6e4
  background #10141d
  border 1px solid #2a3446
  border-radius 6px
  cursor pointer
  transition all 0.15s
  &:hover
    color #0b0f16
    background var(--amber, #5c8dff)
    border-color var(--amber, #5c8dff)

// 全屏时隐藏标题栏:其 -webkit-app-region: drag 拖拽带横贯顶部 40px,
// 会吞掉落在带内(退出按钮 top:8/搜索框 top:5)的真实点击(Electron 已知
// 问题:drag 区可穿透覆盖层;CDP/e2e 点击不走原生层故测不出)
html body .fullscreen .anchor-titlebar
  display none
// 全屏时终端下移,避开 macOS 原生红绿灯(native 控件永远在 DOM 之上)
// pane 类名为 term-wrap-N(N 按布局序,单会话也可能是 2),通配命中
html body .fullscreen .session-wrap.session-current
  [class*='term-wrap-']
    top 40px !important
    height calc(100% - 40px) !important

// 标签关闭按钮:悬停浮现,琥珀 hover
.anchor-tab-close
  display inline-block
  width 16px
  height 16px
  line-height 14px
  text-align center
  border-radius 4px
  color #8b98ab
  font-size 13px
  opacity 0
  transition all 0.12s
  margin-left 2px
.anchor-tab:hover .anchor-tab-close
  opacity 1
.anchor-tab-close:hover
  color #ff6b6b
  background rgba(255, 107, 107, 0.12)

// Win 标题栏:无红绿灯占位,右置窗口控制,保留拖拽
.anchor-titlebar.win
  padding-left 16px
  padding-right 0
  justify-content space-between
  .window-controls
    -webkit-app-region no-drag
    display flex
    align-items center
    height 40px
    .window-control-box
      width 46px
      height 40px
      display flex
      align-items center
      justify-content center
      cursor pointer
      &:hover
        background var(--ink2, #1c2534)
      &.window-control-close:hover
        background #e81123
        color #fff
